	]
	quest.2DF8C60A98135C22.title: "Разведать Дикий лес"
	quest.2DF8C60A98135C22.quest_desc: [
		"Поставь точку возвращения, исследуй местные угрозы и не переноси портал в опасную зону."
		"After completion, identify what this unlocks: a dimension, resource, seal, or technology."
	]
	quest.CA1D4E5D009075D9.title: "Термасект"
	quest.CA1D4E5D009075D9.quest_desc: [
		"Победа открывает химический процессор и связывает DivineRPG с электроникой."
		"After completion, identify what this unlocks: a dimension, resource, seal, or technology."
	]
	quest.9CB180720A3E7DF7.title: "Сердце Дикого леса"
	quest.9CB180720A3E7DF7.quest_desc: [
		"Сохрани сердце как контрольный трофей этапа."
		"After completion, identify what this unlocks: a dimension, resource, seal, or technology."
	]
	quest.2DA7A77FA3CA6F5C.title: "Печать Дикого леса"
	quest.2DA7A77FA3CA6F5C.quest_desc: [
		"Печать используется в межмодовых рецептах без повторного расходования босса."
		"After completion, identify what this unlocks: a dimension, resource, seal, or technology."
	]
	quest.984C69323B6A6FD3.title: "Пневматические платы"
	quest.984C69323B6A6FD3.quest_desc: [
		"Этот этап требует зрелой точной электроники, а не только приключенческой экипировки."
