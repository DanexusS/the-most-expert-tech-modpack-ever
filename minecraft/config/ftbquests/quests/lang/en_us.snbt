	chapter.6EA0FB427B985A5D.title: "Combat Trials of the Reinforced World"
	quest.9DB7C4C613D794E1.title: "Combat trial rules"
	quest.9DB7C4C613D794E1.quest_desc: [
		"This chapter covers the seven mods with strongly increased health. Every branch is optional."
		"Common enemies require small series, elites a few victories, bosses one confirmed kill."
		"Automation may count, but the intended purpose is to test gear and tactics."
	]
	quest.87F138BBBB6381C0.title: "L_Ender’s Cataclysm"
	quest.87F138BBBB6381C0.quest_desc: [
		"Optional combat branch for L_Ender’s Cataclysm; these mobs have stronger health scaling."
		"Counts test repeatability without excessive grind; bosses require one kill."
		"Prepare repairs, healing, backup gear, and a return point."
	]
	quest.560745C3E3EBA2B2.title: "Коболетоны"
	quest.560745C3E3EBA2B2.quest_desc: [
		"Победи группу коболетонов. Они проверяют контроль толпы и устойчивость к серии быстрых атак."
		"Required kills: 12. This quest is optional."
	]
	quest.9B1064461300D42A.title: "Обитатели глубин"
	quest.9B1064461300D42A.quest_desc: [
		"Сразись с обитателями глубин. Под водой важны дыхание, мобильность и оружие без потери темпа."
		"Required kills: 12. This quest is optional."
	]
	quest.85CCF28897DBBD83.title: "Воспламенённые ревенанты"
	quest.85CCF28897DBBD83.quest_desc: [
		"Ревенанты наказывают за долгий бой. Используй сопротивление огню и не стой в зоне повторяющихся атак."
		"Required kills: 6. This quest is optional."
	]
	quest.24DB5E31717F9F37.title: "Эндер-големы"
	quest.24DB5E31717F9F37.quest_desc: [
		"Эндер-големы проверяют броню и умение читать тяжёлые телеграфируемые удары."
		"Required kills: 3. This quest is optional."
	]
	quest.E7315AEFB1B20E7F.title: "Коралловые големы"
	quest.E7315AEFB1B20E7F.quest_desc: [
		"Коралловые големы требуют устойчивого урона и контроля пространства в тесных руинах."
		"Required kills: 3. This quest is optional."
	]
	quest.1E5ADDAD4894C6E3.title: "Коболедиаторы"
	quest.1E5ADDAD4894C6E3.quest_desc: [
		"Коболедиатор — элита ближнего боя. Не обменивайся ударами без уклонения и лечения."
		"Required kills: 3. This quest is optional."
	]
	quest.D8A30D4009DF4966.title: "Незеритовый монстр"
	quest.D8A30D4009DF4966.quest_desc: [
		"Первая крупная проверка Cataclysm: подготовь огнестойкость, дальний план и запас восстановления."
		"Required kills: 1. This quest is optional."
	]
	quest.26585057050E8D51.title: "Игнис"
	quest.26585057050E8D51.quest_desc: [
		"Игнис требует изучения фаз. Сырой урон не заменяет правильное окно атаки."
		"Required kills: 1. This quest is optional."
	]
	quest.CC59411CFAC17C0E.title: "Древний остаток"
	quest.CC59411CFAC17C0E.quest_desc: [
		"Держи дистанцию от рывков и атак по площади; арена должна быть очищена заранее."
		"Required kills: 1. This quest is optional."
	]
	quest.63E93AEE40C8832C.title: "Левиафан"
	quest.63E93AEE40C8832C.quest_desc: [
		"Подводная мобильность и видимость критичны. Проверь экипировку до входа на арену."
		"Required kills: 1. This quest is optional."
	]
	quest.87C278F061AC9950.title: "Предвестник"
	quest.87C278F061AC9950.quest_desc: [
		"Предвестник проверяет защиту от дальнего и взрывного урона, а также стабильность DPS."
		"Required kills: 1. This quest is optional."
	]
	quest.C84600FB65624F75.title: "Эндер-страж"
	quest.C84600FB65624F75.quest_desc: [
		"Изучай направление атак и не позволяй арене заполниться опасными зонами."
		"Required kills: 1. This quest is optional."
	]
	quest.E717DDEFDE0209C9.title: "Маледиктус"
	quest.E717DDEFDE0209C9.quest_desc: [
		"Маледиктус требует дисциплины: сохраняй ресурсы на поздние фазы и не паникуй при смене паттерна."
		"Required kills: 1. This quest is optional."
	]
	quest.7B43297E0786E32D.title: "Сцилла"
	quest.7B43297E0786E32D.quest_desc: [
		"Финальное испытание ветки. Подготовь резервный комплект, еду, лечение и способ быстро вернуться на арену."
		"Required kills: 1. This quest is optional."
	]
	quest.EA9A598682DECC1F.title: "L_Ender’s Cataclysm: trial complete"
	quest.EA9A598682DECC1F.quest_desc: [
		"All combat benchmarks for this branch are complete. No repeated farming is required."
		"The minimal reward reflects that knowledge and proven equipment are the real reward."
	]
	quest.F85F5A682E3CC537.title: "Mowzie's Mobs"
	quest.F85F5A682E3CC537.quest_desc: [
		"Optional combat branch for Mowzie's Mobs; these mobs have stronger health scaling."
		"Counts test repeatability without excessive grind; bosses require one kill."
		"Prepare repairs, healing, backup gear, and a return point."
	]
	quest.6935459B72A6BB98.title: "Фолиаты"
	quest.6935459B72A6BB98.quest_desc: [
		"Фолиаты опасны в растительности. Расчищай обзор и атакуй вне радиуса внезапного укуса."
		"Required kills: 10. This quest is optional."
	]
	quest.BB0723769241726C.title: "Гроттоли"
	quest.BB0723769241726C.quest_desc: [
		"Гроттоли быстры и склонны убегать. Нужна мобильность и точный короткий burst-урон."
		"Required kills: 6. This quest is optional."
	]
	quest.3DB3BC998B24882D.title: "Наги"
	quest.3DB3BC998B24882D.quest_desc: [
		"Наги проверяют дальний бой и движение. Не стой на прямой линии атаки."
		"Required kills: 6. This quest is optional."
	]
	quest.B661B3125C1931DF.title: "Блаффы"
	quest.B661B3125C1931DF.quest_desc: [
		"Блаффы требуют внимательного позиционирования и контроля ближайшего пространства."
		"Required kills: 6. This quest is optional."
	]
	quest.7A6EECDCB014E639.title: "Умвутхана"
	quest.7A6EECDCB014E639.quest_desc: [
		"Серия воинов проверяет щит, уклонение и устойчивость в бою против группы."
		"Required kills: 12. This quest is optional."
	]
	quest.819B805C6AF26241.title: "Рапторы Умвутхана"
	quest.819B805C6AF26241.quest_desc: [
		"Рапторы быстро сокращают дистанцию. Используй препятствия и замедление."
		"Required kills: 6. This quest is optional."
	]
	quest.6469BA1D87F33557.title: "Журавли Умвутхана"
	quest.6469BA1D87F33557.quest_desc: [
		"Летающие противники требуют надёжной дальней атаки и обзора вверх."
		"Required kills: 4. This quest is optional."
	]
	quest.E626A42304691108.title: "Феррусовый кованый рыцарь"
	quest.E626A42304691108.quest_desc: [
		"Не бей в броню бездумно: наблюдай за анимациями и используй правильное окно уязвимости."
		"Required kills: 1. This quest is optional."
	]
	quest.5DED5B01819C32D2.title: "Фростмо"
	quest.5DED5B01819C32D2.quest_desc: [
		"Подготовь защиту от холода и рывков. Держи пространство для отступления."
		"Required kills: 1. This quest is optional."
	]
	quest.DD6E80227E5C2D13.title: "Умвути"
	quest.DD6E80227E5C2D13.quest_desc: [
		"Умвути — проверка понимания механик. Сосредоточься на фазах и источниках опасности, а не только на полосе здоровья."
		"Required kills: 1. This quest is optional."
	]
	quest.0C4CA9508E3A41CC.title: "Mowzie's Mobs: trial complete"
	quest.0C4CA9508E3A41CC.quest_desc: [
		"All combat benchmarks for this branch are complete. No repeated farming is required."
		"The minimal reward reflects that knowledge and proven equipment are the real reward."
	]
	quest.66C116BE7450E685.title: "Mutant Monsters"
	quest.66C116BE7450E685.quest_desc: [
		"Optional combat branch for Mutant Monsters; these mobs have stronger health scaling."
		"Counts test repeatability without excessive grind; bosses require one kill."
		"Prepare repairs, healing, backup gear, and a return point."
	]
	quest.BBFE27A22F15827B.title: "Мутанты-зомби"
	quest.BBFE27A22F15827B.quest_desc: [
		"Мутант-зомби переживает долгий бой и способен продолжить давление. Контролируй дистанцию и добивание."
		"Required kills: 3. This quest is optional."
	]
	quest.2457E04AEC12E4D3.title: "Мутанты-скелеты"
	quest.2457E04AEC12E4D3.quest_desc: [
		"Уклоняйся от дальних атак и не позволяй скелету занимать открытую высоту."
		"Required kills: 3. This quest is optional."
	]
	quest.7F3C9D2396C5B946.title: "Мутанты-криперы"
	quest.7F3C9D2396C5B946.quest_desc: [
		"Не принимай взрыв в упор. Подготовь пространство и способ быстро увеличить дистанцию."
		"Required kills: 3. This quest is optional."
	]
	quest.C0E3948E910D0BE4.title: "Мутанты-эндермены"
	quest.C0E3948E910D0BE4.quest_desc: [
		"Телепортации делают наведение ненадёжным. Используй укрытия и сохраняй контроль камеры."
		"Required kills: 2. This quest is optional."
	]
	quest.84567B021F6E19FC.title: "Паучьи свиньи"
	quest.84567B021F6E19FC.quest_desc: [
		"Серия быстрых существ проверяет контроль толпы и защиту от окружения."
		"Required kills: 6. This quest is optional."
	]
	quest.DBD0591A11ACD2FF.title: "Смешанный налёт"
	quest.DBD0591A11ACD2FF.quest_desc: [
		"Дополнительный норматив: победи ещё пять мутантов-зомби, не полагаясь на одноразовые дорогие расходники."
		"Required kills: 5. This quest is optional."
	]
	quest.872A6E05200A4B10.title: "Mutant Monsters: trial complete"
	quest.872A6E05200A4B10.quest_desc: [
		"All combat benchmarks for this branch are complete. No repeated farming is required."
		"The minimal reward reflects that knowledge and proven equipment are the real reward."
	]
	quest.25ADC8D37BF515CB.title: "Earth Mobs"
	quest.25ADC8D37BF515CB.quest_desc: [
		"Optional combat branch for Earth Mobs; these mobs have stronger health scaling."
		"Counts test repeatability without excessive grind; bosses require one kill."
		"Prepare repairs, healing, backup gear, and a return point."
	]
	quest.C410532DB3BAEFFA.title: "Костяные пауки"
	quest.C410532DB3BAEFFA.quest_desc: [
		"Костяные пауки опасны группой. Следи за флангами и не позволяй им окружить тебя в пещере."
		"Required kills: 12. This quest is optional."
	]
	quest.0C36BD7321B423CF.title: "Злобные ведьмы"
	quest.0C36BD7321B423CF.quest_desc: [
		"Ведьмы создают затяжные негативные эффекты. Молоко или очищение должны быть частью походного набора."
		"Required kills: 8. This quest is optional."
	]
	quest.6F1E0BD6132E4965.title: "Камнеметные зомби"
	quest.6F1E0BD6132E4965.quest_desc: [
		"Двигайся поперёк линии броска и используй укрытия вместо обмена уроном."
		"Required kills: 10. This quest is optional."
	]
	quest.AC1D1590F3649BB1.title: "Зомби-лобберы"
	quest.AC1D1590F3649BB1.quest_desc: [
		"Навесные атаки достают за низкими укрытиями. Меняй позицию после каждого залпа."
		"Required kills: 10. This quest is optional."
	]
	quest.565295BBE73D9B91.title: "Камнеметные утопленники"
	quest.565295BBE73D9B91.quest_desc: [
		"Под водой уклонение сложнее; используй глубину и вертикальное движение."
		"Required kills: 8. This quest is optional."
	]
	quest.C082D1F09C5F4447.title: "Утопленники-лобберы"
	quest.C082D1F09C5F4447.quest_desc: [
		"Не задерживайся на поверхности без обзора: атаки могут приходить из воды."
		"Required kills: 8. This quest is optional."
	]
	quest.83A9D276B0D641CF.title: "Замёрзшие камнеметатели"
	quest.83A9D276B0D641CF.quest_desc: [
		"Холодная местность ограничивает движение. Подготовь чистую площадку и устойчивую еду."
		"Required kills: 8. This quest is optional."
	]
	quest.5D762F6D71BD7E41.title: "Пустынные лобберы"
	quest.5D762F6D71BD7E41.quest_desc: [
		"Открытая пустыня помогает видеть снаряды, но оставляет без укрытий — строй временные барьеры."
		"Required kills: 8. This quest is optional."
	]
	quest.F1AA15929A779D76.title: "Тропические слизни"
	quest.F1AA15929A779D76.quest_desc: [
		"Следи за разделением слизней и не позволяй мелким формам заполнить арену."
		"Required kills: 12. This quest is optional."
	]
	quest.723815B1898A99B0.title: "Скелетные волки"
	quest.723815B1898A99B0.quest_desc: [
		"Волки атакуют быстро и группой. Приоритет — не дать стае зайти за спину."
		"Required kills: 10. This quest is optional."
	]
	quest.82EC38301CA97012.title: "Иссушающие скелетные волки"
	quest.82EC38301CA97012.quest_desc: [
		"Эффект иссушения делает размен ударами опасным. Используй щит, дальний урон и лечение."
		"Required kills: 6. This quest is optional."
	]
	quest.FAC328E3D2A791BC.title: "Зомбифицированные кролики"
	quest.FAC328E3D2A791BC.quest_desc: [
		"Небольшая цель с высокой подвижностью проверяет точность и контроль местности."
		"Required kills: 10. This quest is optional."
	]
	quest.BDA2C6EAE21EB8FF.title: "Earth Mobs: trial complete"
	quest.BDA2C6EAE21EB8FF.quest_desc: [
		"All combat benchmarks for this branch are complete. No repeated farming is required."
		"The minimal reward reflects that knowledge and proven equipment are the real reward."
	]
	quest.F8BEF4249A185BA2.title: "DivineRPG"
	quest.F8BEF4249A185BA2.quest_desc: [
		"Optional combat branch for DivineRPG; these mobs have stronger health scaling."
		"Counts test repeatability without excessive grind; bosses require one kill."
		"Prepare repairs, healing, backup gear, and a return point."
	]
	quest.04A0EEE797E8B329.title: "Древняя сущность"
	quest.04A0EEE797E8B329.quest_desc: [
		"Начальная проверка DivineRPG. Не недооценивай бой из-за раннего положения в маршруте."
		"Required kills: 1. This quest is optional."
	]
	quest.6D31B8934FC38121.title: "Наблюдатель"
	quest.6D31B8934FC38121.quest_desc: [
		"Следи за дальними атаками и сохраняй свободный маршрут отхода."
		"Required kills: 1. This quest is optional."
	]
	quest.7B868EA3A78BC38A.title: "Король скорчеров"
	quest.7B868EA3A78BC38A.quest_desc: [
		"Огнестойкость уменьшает риск, но не заменяет уклонение от тяжёлых атак."
		"Required kills: 1. This quest is optional."
	]
	quest.A30363FE4AAE8CC9.title: "Айерако"
	quest.A30363FE4AAE8CC9.quest_desc: [
		"Подготовь арену и не допускай одновременного давления нескольких целей."
		"Required kills: 1. This quest is optional."
	]
	quest.302D30F04E5AA4EF.title: "Солнечный шторм"
	quest.302D30F04E5AA4EF.quest_desc: [
		"Эдем повышает требования к урону. Проверь ремонт и запас боеприпасов заранее."
		"Required kills: 1. This quest is optional."
	]
	quest.1F62439F5FE3C2AD.title: "Термасект"
	quest.1F62439F5FE3C2AD.quest_desc: [
		"Дикий лес проверяет защиту от быстрых атак и способность сохранять темп."
		"Required kills: 1. This quest is optional."
	]
	quest.5380049C01C95D7D.title: "Вечный лучник"
	quest.5380049C01C95D7D.quest_desc: [
		"Используй укрытия и сокращай дистанцию только в безопасное окно."
		"Required kills: 1. This quest is optional."
	]
	quest.659B0611CD356C68.title: "Опытный Кори"
	quest.659B0611CD356C68.quest_desc: [
		"Не позволяй затяжному бою истощить лечение — повышай стабильный урон."
		"Required kills: 1. This quest is optional."
	]
	quest.DC9C321AE529E577.title: "Парасекта"
	quest.DC9C321AE529E577.quest_desc: [
		"Первый хранитель подземелья: очисти окружающих мобов до призыва."
		"Required kills: 1. This quest is optional."
	]
	quest.451A5FAA93C1974C.title: "Драмикс"
	quest.451A5FAA93C1974C.quest_desc: [
		"Второй хранитель: следи за пространством и не зажимай себя в углу."
		"Required kills: 1. This quest is optional."
	]
	quest.11DE509974AFE152.title: "Демон душ"
	quest.11DE509974AFE152.quest_desc: [
		"Мортум начинает серию боссов. Планируй расходники сразу на несколько боёв."
		"Required kills: 1. This quest is optional."
	]
	quest.4C66EB18C393582A.title: "Сумеречный демон"
	quest.4C66EB18C393582A.quest_desc: [
		"Сохраняй мобильность и не расходуй все сильные способности в первой фазе."
		"Required kills: 1. This quest is optional."
	]
	quest.E62F13AFB6ACFEBF.title: "Вамахерон"
	quest.E62F13AFB6ACFEBF.quest_desc: [
		"Оценивай окна атаки и не пытайся пробить увеличенное здоровье одним burst-комбо."
		"Required kills: 1. This quest is optional."
	]
	quest.F624FC55DFE40400.title: "Денсос"
	quest.F624FC55DFE40400.quest_desc: [
		"Продолжай серию Мортума, контролируя прочность брони и оружия."
		"Required kills: 1. This quest is optional."
	]
	quest.C580DF08A8DB3ECD.title: "Рейвор"
	quest.C580DF08A8DB3ECD.quest_desc: [
		"Проверка устойчивости: бой должен быть повторяемым без полной смены инфраструктуры."
		"Required kills: 1. This quest is optional."
	]
	quest.F1CE383570D58AE3.title: "Карот"
	quest.F1CE383570D58AE3.quest_desc: [
		"Заверши основной ряд Мортума и собери ресурсы для следующего технологического допуска."
		"Required kills: 1. This quest is optional."
	]
	quest.BF45A9521B89E0AB.title: "Королева улья"
	quest.BF45A9521B89E0AB.quest_desc: [
		"Ветея требует отдельной подготовки: ограниченные ресурсы и длинная серия боссов."
		"Required kills: 1. This quest is optional."
	]
	quest.93DAF2405F7C6B61.title: "Квадро"
	quest.93DAF2405F7C6B61.quest_desc: [
		"Не торопи бой — сохраняй лечение для второй половины."
		"Required kills: 1. This quest is optional."
	]
	quest.44314D23B11860D9.title: "Карос"
	quest.44314D23B11860D9.quest_desc: [
		"Следи за паттернами и не расходуй редкие предметы до понимания механики."
		"Required kills: 1. This quest is optional."
	]
	quest.FB0024D638993EA7.title: "Раглок"
	quest.FB0024D638993EA7.quest_desc: [
		"Средняя контрольная точка Ветеи: проверь состояние экипировки перед продолжением."
		"Required kills: 1. This quest is optional."
	]
	quest.DA9B8FDEE4388664.title: "Рэк"
	quest.DA9B8FDEE4388664.quest_desc: [
		"Рэк охраняет переход к финальным технологиям; бой должен быть подготовлен полностью."
		"Required kills: 1. This quest is optional."
	]
	quest.7CEC08E3A10B8AA1.title: "Леди Луна"
	quest.7CEC08E3A10B8AA1.quest_desc: [
		"Финальная проверка маршрута DivineRPG. Возьми резервный комплект и план возвращения."
		"Required kills: 1. This quest is optional."
	]
	quest.B8A9279E28B5721F.title: "Китра"
	quest.B8A9279E28B5721F.quest_desc: [
		"Необязательный водный босс: подготовь дыхание, подводную скорость и ясный обзор."
		"Required kills: 1. This quest is optional."
	]
	quest.0329FBB59A588116.title: "DivineRPG: trial complete"
	quest.0329FBB59A588116.quest_desc: [
		"All combat benchmarks for this branch are complete. No repeated farming is required."
		"The minimal reward reflects that knowledge and proven equipment are the real reward."
	]
	quest.219439215FD5E2E0.title: "Twilight Forest"
	quest.219439215FD5E2E0.quest_desc: [
		"Optional combat branch for Twilight Forest; these mobs have stronger health scaling."
		"Counts test repeatability without excessive grind; bosses require one kill."
		"Prepare repairs, healing, backup gear, and a return point."
	]
	quest.CEE4AB8D1AAB2428.title: "Красные колпаки"
	quest.CEE4AB8D1AAB2428.quest_desc: [
		"Гоблины опасны группой в тесных шахтах. Освещай маршрут и не позволяй окружить себя."
		"Required kills: 12. This quest is optional."
	]
	quest.4EF458B0710AE0A8.title: "Красные сапёры"
	quest.4EF458B0710AE0A8.quest_desc: [
		"Сапёры используют взрывчатку. Не сражайся рядом с важными сундуками и проходами."
		"Required kills: 6. This quest is optional."
	]
	quest.660EE9E509253392.title: "Минотавры"
	quest.660EE9E509253392.quest_desc: [
		"Коридоры лабиринта усиливают рывки минотавров. Используй повороты как укрытие."
		"Required kills: 10. This quest is optional."
	]
	quest.E9970727C1D4D3E2.title: "Лабиринтные слизни"
	quest.E9970727C1D4D3E2.quest_desc: [
		"Контролируй разделение слизней, чтобы бой не превратился в бесконечную толпу."
		"Required kills: 12. This quest is optional."
	]
	quest.B8F40D0C4D6407A2.title: "Рыцари-гоблины"
	quest.B8F40D0C4D6407A2.quest_desc: [
		"Бронированные противники требуют терпения и атак в открытые зоны."
		"Required kills: 6. This quest is optional."
	]
	quest.EBE28645F7F1ECEC.title: "Паучий выводок"
	quest.EBE28645F7F1ECEC.quest_desc: [
		"Мелкие пауки проверяют урон по площади и способность отступать без застревания."
		"Required kills: 16. This quest is optional."
	]
	quest.4C3250D26871C4E5.title: "Лесные пауки"
	quest.4C3250D26871C4E5.quest_desc: [
		"В лабиринте живой изгороди обзор ограничен. Держи щит и освещение готовыми."
		"Required kills: 12. This quest is optional."
	]
	quest.F06D8955564D8064.title: "Нага"
	quest.F06D8955564D8064.quest_desc: [
		"Первая большая арена. Не стой у стен и следи за изменением скорости босса."
		"Required kills: 1. This quest is optional."
	]
	quest.1E51BF53FDBC253E.title: "Сумеречный лич"
	quest.1E51BF53FDBC253E.quest_desc: [
		"Разберись с защитной фазой и отражением снарядов, прежде чем тратить сильное оружие."
		"Required kills: 1. This quest is optional."
	]
	quest.02475C5A07092C74.title: "Миношрум"
	quest.02475C5A07092C74.quest_desc: [
		"Лабиринт ограничивает уклонение. Очисти комнату и подготовь путь отхода."
		"Required kills: 1. This quest is optional."
	]
	quest.22730642E4742859.title: "Гидра"
	quest.22730642E4742859.quest_desc: [
		"Сражайся на дистанции, читай атаки голов и не стой в длительных огненных зонах."
		"Required kills: 1. This quest is optional."
	]
	quest.C5C3C6FFAB216971.title: "Призрачные рыцари"
	quest.C5C3C6FFAB216971.quest_desc: [
		"Это групповая схватка. Фокусируй одну цель и не теряй остальных из поля зрения."
		"Required kills: 6. This quest is optional."
	]
	quest.9FC55366C84B08F3.title: "Ур-гаст"
	quest.9FC55366C84B08F3.quest_desc: [
		"Подготовь дальнее оружие и понимание механики ловушек башни."
		"Required kills: 1. This quest is optional."
	]
	quest.1792E93E5DAEB303.title: "Альфа-йети"
	quest.1792E93E5DAEB303.quest_desc: [
		"Используй пространство пещеры и не позволяй броскам загнать тебя в стену."
		"Required kills: 1. This quest is optional."
	]
	quest.C3785760E8B80566.title: "Снежная королева"
	quest.C3785760E8B80566.quest_desc: [
		"Финальная проверка региона: сохраняй мобильность и лечение на поздние фазы."
		"Required kills: 1. This quest is optional."
	]
	quest.8881BBA5F1EA20E9.title: "Twilight Forest: trial complete"
	quest.8881BBA5F1EA20E9.quest_desc: [
		"All combat benchmarks for this branch are complete. No repeated farming is required."
		"The minimal reward reflects that knowledge and proven equipment are the real reward."
	]
	quest.3C4570590B13213A.title: "Ice and Fire"
	quest.3C4570590B13213A.quest_desc: [
		"Optional combat branch for Ice and Fire; these mobs have stronger health scaling."
		"Counts test repeatability without excessive grind; bosses require one kill."
		"Prepare repairs, healing, backup gear, and a return point."
	]
	quest.4D6E1D2F608F92CA.title: "Кокатрисы"
	quest.4D6E1D2F608F92CA.quest_desc: [
		"Избегай длительного зрительного контакта и разбирайся с группой по одной цели."
		"Required kills: 8. This quest is optional."
	]
	quest.8898ADDD442B2EEC.title: "Сирены"
	quest.8898ADDD442B2EEC.quest_desc: [
		"Подготовь защиту от контроля и не входи в воду без плана выхода."
		"Required kills: 8. This quest is optional."
	]
	quest.878F80CBD13339F6.title: "Тролли"
	quest.878F80CBD13339F6.quest_desc: [
		"Тролли обладают большим здоровьем. Используй уязвимости и не веди бой в тесноте."
		"Required kills: 6. This quest is optional."
	]
	quest.F8EC1B86DE04A9EA.title: "Стимфалийские птицы"
	quest.F8EC1B86DE04A9EA.quest_desc: [
		"Стая опаснее одиночной птицы. Дальнее оружие и укрытие от перьев обязательны."
		"Required kills: 12. This quest is optional."
	]
	quest.E953C1E749BF2BD3.title: "Призраки"
	quest.E953C1E749BF2BD3.quest_desc: [
		"Призраки осложняют ночные походы. Освещение и быстрый способ добивания уменьшают риск."
		"Required kills: 12. This quest is optional."
	]
	quest.6D94030EA589B1D9.title: "Черви смерти"
	quest.6D94030EA589B1D9.quest_desc: [
		"Следи за движением песка и не стой на одном месте в открытой пустыне."
		"Required kills: 8. This quest is optional."
	]
	quest.C60743DB04D70A71.title: "Морские змеи"
	quest.C60743DB04D70A71.quest_desc: [
		"Используй лодку или подводную мобильность только с путём отхода; змеи быстро разрушают неподготовленный транспорт."
		"Required kills: 4. This quest is optional."
	]
	quest.022ED08D274E542E.title: "Циклопы"
	quest.022ED08D274E542E.quest_desc: [
		"Не принимай тяжёлые удары в упор. Используй рельеф и точные атаки."
		"Required kills: 3. This quest is optional."
	]
	quest.F178D187628FA3BF.title: "Горгоны"
	quest.F178D187628FA3BF.quest_desc: [
		"Подготовь способ избежать смертельного взгляда и не входи в бой без знания механики."
		"Required kills: 2. This quest is optional."
	]
	quest.B5477F84F59B8DBD.title: "Гидра"
	quest.B5477F84F59B8DBD.quest_desc: [
		"Гидра требует управления регенерацией и безопасного удаления голов."
		"Required kills: 1. This quest is optional."
	]
	quest.CAF1A34DE1DB42FB.title: "Огненные драконы"
	quest.CAF1A34DE1DB42FB.quest_desc: [
		"Три победы подтверждают стабильность комплекта. Огнестойкость, мобильность и дальний урон обязательны."
		"Required kills: 3. This quest is optional."
	]
	quest.0BE6432899E318A5.title: "Ледяные драконы"
	quest.0BE6432899E318A5.quest_desc: [
		"Замедление делает ошибки опаснее. Подготовь сопротивление холоду и запас дистанции."
		"Required kills: 3. This quest is optional."
	]
	quest.7A29579DC6AEB8E4.title: "Грозовые драконы"
	quest.7A29579DC6AEB8E4.quest_desc: [
		"Молниеносные атаки требуют надёжной брони и постоянного движения. Не сражайся рядом с базой."
		"Required kills: 3. This quest is optional."
	]
	quest.C54307C6C556B383.title: "Ice and Fire: trial complete"
	quest.C54307C6C556B383.quest_desc: [
		"All combat benchmarks for this branch are complete. No repeated farming is required."
		"The minimal reward reflects that knowledge and proven equipment are the real reward."
	]
