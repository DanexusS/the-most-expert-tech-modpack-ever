{
  "schema_version": 3,
  "ftb_quests": {
    "minimum_detection_delay_ticks": 80,
    "maximum_grid_scale": 0.5,
    "verify_on_load": false,
    "drop_loot_crates": false
  },
  "logging": {
    "coroutil_routine_logging": false,
    "coroutil_debug_logging": false,
    "coroutil_error_logging": true
  },
  "startup_io": {
    "diagnostic_mod_inventory_enabled_by_default": false,
    "diagnostic_mod_inventory_property": "expert.modInventoryExport",
    "forbid_unguarded_startup_file_writes": true
  },
  "combat_scaling": {
    "require_profile_cache": true,
    "require_entity_type_identity_cache": true,
    "require_stable_modifier_ids": true,
    "require_registry_guard": true
  },
  "hot_path_budgets": {
    "maximum_tick_subscriptions": 4,
    "maximum_spawn_subscriptions": 4,
    "maximum_hurt_subscriptions": 4,
    "forbid_file_io_in_high_frequency_handlers": true,
    "forbid_registry_full_scans_in_high_frequency_handlers": true,
    "forbid_console_calls_in_high_frequency_handlers": true
  },
  "release_runtime_targets": {
    "maximum_startup_regression_percent": 10.0,
    "maximum_world_load_regression_percent": 10.0,
    "minimum_soak_tps_p05": 19.0,
    "maximum_soak_mspt_p95": 50.0,
    "maximum_post_gc_heap_growth_percent": 10.0,
    "maximum_repeated_log_lines_per_minute": 30
  },
  "repository_hygiene": {
    "forbidden_tracked_paths": [
      "command_history.txt",
      "ESM/",
      "logs/",
      "crash-reports/",
      "local/",
      "saves/"
    ],
    "required_gitignore_entries": [
      "/command_history.txt",
      "/ESM/",
      "/logs/",
      "/crash-reports/",
      "/local/",
      "/saves/"
    ]
  },
  "factory_guidance": {
    "require_measured_baseline": true,
    "require_idle_shutdown": true,
    "require_chunk_reload_recovery": true,
    "require_bounded_buffers": true,
    "minimum_workflow_optimization_quests": 90,
    "minimum_depth_optimization_quests": 180
  },
  "script_budgets": {
    "maximum_javascript_files": 212,
    "maximum_event_subscriptions": 205,
    "maximum_console_calls": 22
  },
  "questbook_budgets": {
    "minimum_mandatory_quests_per_stage": 100,
    "maximum_mandatory_quests_per_stage": 140,
    "maximum_total_quests": 6000
  }
}
